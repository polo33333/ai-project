# Server Configuration
PORT=3000
HOST=127.0.0.1
SHUTDOWN_TIMEOUT_MS=10000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Required only on the first startup when data/accounts.json does not exist; replace this value.
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-start
SESSION_TOUCH_INTERVAL_MS=300000
KNOWLEDGEHUB_BACKUP_DIR=./backups
KNOWLEDGEHUB_DATA_DIR=./data
# Optional override for generated downloads; defaults to KNOWLEDGEHUB_DATA_DIR/exports.
KNOWLEDGEHUB_EXPORT_DIR=./data/exports

# AI provider request timeouts (milliseconds)
AI_DEFAULT_TIMEOUT_MS=30000
AI_LOCAL_TIMEOUT_MS=180000
WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
WEB_SEARCH_TIMEOUT_MS=15000
MCP_CONNECT_TIMEOUT_MS=15000
MCP_CALL_TIMEOUT_MS=30000
WEB_SEARCH_MAX_RESULTS=5

# Separate agent harness for local chat models
LOCAL_MODEL_HARNESS_ENABLED=true
LOCAL_MODEL_ALLOW_CLOUD_FALLBACK=false
LOCAL_MODEL_SCHEMA_SELECTOR_ENABLED=false

# Provider completion checks (set false to restore the legacy provider loop)
AI_PROVIDER_GUARDS_ENABLED=true
AI_PROVIDER_MAX_REPAIRS=2
AI_PROVIDER_REQUEST_TIMEOUT_MS=120000
AI_PROVIDER_MAX_MODEL_CALLS=12
AI_PROVIDER_MAX_SQL_CALLS=3
AI_PROVIDER_MAX_TOOL_CALLS=20
AI_PROVIDER_TOOL_RESULT_CHARS=12000
# Conservative defaults; override contextWindow/outputReserve per provider.
AI_PROVIDER_CONTEXT_WINDOW=16384
AI_PROVIDER_OUTPUT_RESERVE=2048
LOCAL_MODEL_SKILL_CORE_ENABLED=false
LOCAL_MODEL_FEW_SHOT_ENABLED=false
LOCAL_MODEL_MAX_ITERATIONS=7
LOCAL_MODEL_MAX_MODEL_CALLS=9
LOCAL_MODEL_MAX_SQL_CALLS=3
LOCAL_MODEL_MAX_REPAIRS=1
LOCAL_MODEL_TOOL_RESULT_CHARS=6000
LOCAL_MODEL_TEMPERATURE=0.1
LOCAL_MODEL_NUM_CTX=16384
LOCAL_MODEL_NUM_PREDICT=2048
LOCAL_MODEL_KEEP_ALIVE=10m

# Dynamic schema retrieval budget
AI_SCHEMA_MAX_TABLES=6
AI_SCHEMA_MAX_COLUMNS_PER_TABLE=40
AI_SCHEMA_MAX_CONTEXT_CHARS=18000

# Backend conversation memory
AI_MEMORY_RECENT_MESSAGES=10
AI_MEMORY_MAX_MESSAGES=40
AI_MEMORY_SUMMARY_CHARS=4000
AI_MEMORY_MAX_SESSIONS=500

# Qdrant Vector Database Configuration
QDRANT_URL=http://127.0.0.1:6333
# Local startup uses the knowledgehub-qdrant Docker service, not qdrant.exe.
QDRANT_COLLECTION=database_schema_v2
QDRANT_VECTOR_SIZE=1024
LIBRARY_MAX_FILE_MB=20
QDRANT_DOCUMENT_COLLECTION=knowledge_documents_bge_m3_v1
QDRANT_DOCUMENT_VECTOR_SIZE=1024
AI_DOCUMENT_CONTEXT_CHARS=12000
AI_DOCUMENT_MIN_SCORE=0.15

# Document embedding (BGE-M3 through Ollama or an OpenAI-compatible endpoint)
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
# Set to "error" in production to prohibit pseudo-vector fallback.
EMBEDDING_FALLBACK_MODE=error

# Hybrid retrieval and optional cross-encoder reranking
RETRIEVAL_CANDIDATE_LIMIT=30
RRF_K=60
RERANKER_ENABLED=false
RERANKER_BASE_URL=http://127.0.0.1:8081
RERANKER_MODEL=bge-reranker-v2-m3
GRAPHRAG_ENABLED=true
# Enable once after changing the embedding model/collection, then turn it off.
KNOWLEDGE_REINDEX_ON_START=false
# Memory Core v2 (staged rollout; disabled by default)
MEMORY_PENDING_TURN_ENABLED=false
MEMORY_PENDING_TURN_TTL_MINUTES=30
MEMORY_CONTEXT_BUDGET_ENABLED=false
MEMORY_SUMMARY_ENABLED=false
MEMORY_SEMANTIC_ROUTING_ENABLED=false
MEMORY_TOKEN_CHARS_PER_TOKEN=3.2

# App storage. Import data and run data:pg:cutover before starting PostgreSQL runtime.
# JSON is available explicitly for isolated fixtures/verified rollback exports.
APP_STORAGE_BACKEND=postgres
APP_PG_HOST=127.0.0.1
APP_PG_PORT=5432
APP_PG_DATABASE=knowledgehub_app
APP_PG_POOL_MAX=5
APP_PG_CONNECT_TIMEOUT_MS=5000
APP_PG_STATEMENT_TIMEOUT_MS=30000
APP_PG_DOCKER_CONTAINER=knowledgehub-postgres
# Generated locally by npm run db:pg:init in ignored .env.postgres:
# APP_PG_USER=knowledgehub_migrator
# APP_PG_PASSWORD=
# APP_PG_RUNTIME_USER=knowledgehub_runtime
# APP_PG_RUNTIME_PASSWORD=
# APP_DATA_ENCRYPTION_KEY_FILE=C:\Users\<user>\.knowledgehub\keys\<id>.key
# For remote PostgreSQL, provide a trusted CA file (certificate checks stay enabled):
# APP_PG_SSL_CA_FILE=
