# Server Configuration
# @env NODE_ENV: Chế độ vận hành. Chọn production cho hệ thống thật, development khi phát triển hoặc test khi kiểm thử. production: vận hành; development: phát triển; test: kiểm thử.
NODE_ENV=production
# @env TRUST_PROXY: Tin cậy reverse proxy. Bật khi ứng dụng chạy sau reverse proxy đã cấu hình đúng để đọc giao thức chuyển tiếp. Lựa chọn: true = bật; false = tắt.
TRUST_PROXY=false
# @env API_BODY_MAX_BYTES: Dung lượng request API tối đa. Giới hạn kích thước request JSON gửi tới API, tính bằng byte.
API_BODY_MAX_BYTES=1048576
# @env CHAT_RATE_WINDOW_MS: Khoảng thời gian giới hạn chat. Khoảng thời gian tính số request chat, tính bằng mili giây. Đơn vị: mili giây (1000 ms = 1 giây).
CHAT_RATE_WINDOW_MS=60000
# @env CHAT_RATE_MAX: Số request chat tối đa. Số request chat tối đa trong mỗi khoảng giới hạn.
CHAT_RATE_MAX=30
# @env PORT: Cổng truy cập ứng dụng. Cổng HTTP của máy chủ, từ 1 đến 65535. Ví dụ 3000 tương ứng http://localhost:3000; đổi cổng sẽ đổi địa chỉ truy cập.
PORT=3000
# @env HOST: Địa chỉ máy chủ. Địa chỉ backend lắng nghe. 127.0.0.1 chỉ cho phép truy cập từ máy hiện tại.
HOST=127.0.0.1
# Optional HTTPS: set both paths to PEM files. Relative paths start at the project root.
# @env HTTPS_CERT_FILE: Chứng chỉ HTTPS. Đường dẫn file chứng chỉ PEM; đặt cùng HTTPS_KEY_FILE để bật HTTPS. Bỏ trống/không khai báo để dùng HTTP. Đường dẫn tương đối tính từ thư mục dự án.
# HTTPS_CERT_FILE=./certs/server.crt
# @env HTTPS_KEY_FILE: Khóa riêng HTTPS. Đường dẫn private key PEM tương ứng chứng chỉ HTTPS_CERT_FILE. Không chia sẻ nội dung khóa.
# HTTPS_KEY_FILE=./certs/server.key
# @env SHUTDOWN_TIMEOUT_MS: Thời gian chờ tắt máy chủ. Thời gian tối đa chờ request và worker kết thúc trước khi tắt, tính bằng mili giây. Đơn vị: mili giây (1000 ms = 1 giây).
SHUTDOWN_TIMEOUT_MS=10000
# @env CORS_ALLOWED_ORIGINS: Website được phép kết nối. Danh sách origin được phép gọi API, phân cách bằng dấu phẩy. Ví dụ http://localhost:3000.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Required only on the first startup when data/accounts.json does not exist; replace this value.
# @env BOOTSTRAP_ADMIN_PASSWORD: Mật khẩu admin khởi tạo. Mật khẩu tạo tài khoản admin khi chưa có dữ liệu tài khoản. Đổi giá trị mẫu trước lần khởi động đầu tiên; không dùng để đổi mật khẩu tài khoản đã tồn tại.
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-start
# @env SESSION_TOUCH_INTERVAL_MS: Chu kỳ cập nhật phiên đăng nhập. Khoảng cách giữa các lần lưu thời hạn phiên, tính bằng mili giây. 300000 tương đương 5 phút. Đơn vị: mili giây (1000 ms = 1 giây).
SESSION_TOUCH_INTERVAL_MS=300000
# @env KNOWLEDGEHUB_BACKUP_DIR: Thư mục sao lưu. Nơi lưu backup dữ liệu và manifest. Đường dẫn tương đối tính từ thư mục dự án.
KNOWLEDGEHUB_BACKUP_DIR=./backups
# @env KNOWLEDGEHUB_DATA_DIR: Thư mục dữ liệu. Thư mục chứa dữ liệu vận hành của ứng dụng.
KNOWLEDGEHUB_DATA_DIR=./data
# Optional override for generated downloads; defaults to KNOWLEDGEHUB_DATA_DIR/exports.
# @env KNOWLEDGEHUB_EXPORT_DIR: Thư mục file xuất. Thư mục lưu các file Excel, CSV hoặc PDF được tạo để tải xuống.
KNOWLEDGEHUB_EXPORT_DIR=./data/exports

# AI agent and provider request timeouts (milliseconds)
# @env AGENT_CORE_ENABLED: Bật Agent Core. Bật luồng điều phối công cụ và kế hoạch thực thi của AI. Lựa chọn: true = bật; false = tắt.
AGENT_CORE_ENABLED=true
# @env AI_MAX_TOOL_ITERATIONS: Số vòng gọi công cụ AI. Giới hạn vòng gọi công cụ của luồng AI chính. Tăng cho tác vụ nhiều bước nhưng cần thêm thời gian và token.
AI_MAX_TOOL_ITERATIONS=5
# @env AI_CONVERSATION_HISTORY: Lịch sử gửi tới AI. Số tin nhắn hội thoại gần nhất được đưa vào request AI.
AI_CONVERSATION_HISTORY=20
# @env AI_DEFAULT_TIMEOUT_MS: Thời gian chờ AI mặc định. Giới hạn chờ mỗi yêu cầu AI, tính bằng mili giây. 30000 = 30 giây; tăng nếu model trả lời chậm. Đơn vị: mili giây (1000 ms = 1 giây).
AI_DEFAULT_TIMEOUT_MS=30000
# @env AI_LOCAL_TIMEOUT_MS: Thời gian chờ AI local. Giới hạn chờ model chạy nội bộ. 180000 = 3 phút; tăng giúp model chậm có thêm thời gian nhưng người dùng phải chờ lâu hơn. Đơn vị: mili giây (1000 ms = 1 giây).
AI_LOCAL_TIMEOUT_MS=180000
# @env WEB_SEARCH_ENDPOINT: Địa chỉ tìm kiếm web. Endpoint được dịch vụ tìm kiếm gọi để lấy kết quả. Cần tương thích với cách ứng dụng đọc kết quả tìm kiếm.
WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
# @env WEB_SEARCH_TIMEOUT_MS: Thời gian chờ tìm kiếm. Giới hạn thời gian yêu cầu tìm kiếm web. 15000 mili giây = 15 giây. Đơn vị: mili giây (1000 ms = 1 giây).
WEB_SEARCH_TIMEOUT_MS=15000
# @env MCP_CONNECT_TIMEOUT_MS: Thời gian kết nối MCP. Giới hạn thời gian kết nối tới MCP server, tính bằng mili giây. Đơn vị: mili giây (1000 ms = 1 giây).
MCP_CONNECT_TIMEOUT_MS=15000
# @env MCP_CALL_TIMEOUT_MS: Thời gian gọi MCP. Giới hạn thời gian thực thi một MCP tool, tính bằng mili giây. Đơn vị: mili giây (1000 ms = 1 giây).
MCP_CALL_TIMEOUT_MS=30000
# @env WEB_SEARCH_MAX_RESULTS: Số kết quả tìm kiếm. Số kết quả web tối đa được lấy. Tăng để có thêm nguồn tham khảo nhưng nội dung xử lý cũng nhiều hơn.
WEB_SEARCH_MAX_RESULTS=5

# Separate agent harness for local chat models
# @env CHAT_ROUTING_MODE: Model quyết định định tuyến. local_tev1: dùng TEV1 local; chat_model: dùng đúng model chat đã chọn; auto: TEV1 trước, chuyển một lần sang model chat nếu mơ hồ hoặc lỗi. Model trả lời luôn giữ theo lựa chọn chat. Áp dụng sau khi khởi động lại. auto: TEV1 trước, chuyển model chat khi không chắc/lỗi; local_tev1: chỉ TEV1 quyết định luồng, không fallback routing; chat_model: model chat quyết định ngay. Chat thông thường vẫn cần model trả lời.
CHAT_ROUTING_MODE=auto
# Qdrant + lexical shortlist before TEV1. off/shadow/on; enable after indexing and evaluation.
CHAT_ROUTING_RETRIEVAL_MODE=off
CHAT_ROUTING_RETRIEVAL_METHOD=hybrid
CHAT_ROUTING_RETRIEVAL_COLLECTION=workflow_routing_v1
CHAT_ROUTING_RETRIEVAL_TOP_K=15
CHAT_ROUTING_RETRIEVAL_TASK_TARGET_TOKENS=1700
CHAT_ROUTING_RETRIEVAL_TIMEOUT_MS=15000
# TEV1 confidently identifies a greeting-only turn: reply locally without chat model.
# @env CHAT_QUICK_GREETING_ENABLED: Trả lời chào hỏi nhanh. true: TEV1 nhận diện câu chỉ chào hỏi và backend trả lời mẫu, không gọi model chat; false: xử lý qua luồng chat bình thường. Chỉ áp dụng với auto/local_tev1; chào kèm yêu cầu vẫn chọn nghiệp vụ. Lựa chọn: true = bật; false = tắt.
CHAT_QUICK_GREETING_ENABLED=true
# @env CHAT_ROUTING_LOCAL_MODEL: Model local định tuyến. Tên model Ollama chuyên quyết định chat/nghiệp vụ và nhận diện input, mặc định tev1:4b. Model này phải được cài trên endpoint routing.
CHAT_ROUTING_LOCAL_MODEL=tev1:4b
# Independent Ollama endpoint for routing; chat provider remains pinned.
# @env CHAT_ROUTING_LOCAL_BASE_URL: Địa chỉ Ollama định tuyến. Endpoint Ollama cho model quyết định, mặc định http://127.0.0.1:11434. Độc lập với provider chat và embedding.
CHAT_ROUTING_LOCAL_BASE_URL=http://127.0.0.1:11434
# @env CHAT_ROUTING_TIMEOUT_MS: Thời gian chờ định tuyến. Giới hạn mỗi lần gọi model quyết định, tính bằng mili giây; cả routing và model trả lời cùng dùng ngân sách tổng request. Đơn vị: mili giây (1000 ms = 1 giây).
CHAT_ROUTING_TIMEOUT_MS=60000
# @env CHAT_ROUTING_MIN_PROBABILITY: Ngưỡng lựa chọn TEV1. Xác suất lựa chọn tối thiểu để chấp nhận quyết định TEV1 (0–1). Đây không phải độ chính xác; cần kiểm chứng trên nghiệp vụ thật.
CHAT_ROUTING_MIN_PROBABILITY=0.65
# @env CHAT_ROUTING_MIN_MARGIN: Khoảng cách lựa chọn TEV1. Chênh lệch tối thiểu giữa hai xác suất cao nhất của TEV1 (0–1). Dưới ngưỡng thì hỏi lại hoặc chuyển model chat trong auto.
CHAT_ROUTING_MIN_MARGIN=0.15
# @env LOCAL_AI_MODEL: Model local khi khởi chạy. Tên model được script start-local.ps1 sử dụng, ví dụ qwen3.5:9b. Cấu hình provider trong ứng dụng được quản lý riêng.
LOCAL_AI_MODEL=qwen3.5:9b
# @env LOCAL_MODEL_THINK: Bật chế độ suy luận local. Cho phép Ollama sử dụng chế độ think nếu model hỗ trợ. Lựa chọn: true = bật; false = tắt.
LOCAL_MODEL_THINK=false
# @env LOCAL_MODEL_HARNESS_ENABLED: Luồng xử lý riêng cho AI local. Bật luồng điều phối dành cho model nội bộ để thực hiện gọi công cụ và xử lý kết quả qua nhiều bước. Lựa chọn: true = bật; false = tắt.
LOCAL_MODEL_HARNESS_ENABLED=true
# @env LOCAL_MODEL_ALLOW_CLOUD_FALLBACK: Cho phép chuyển sang AI cloud. Cho phép dùng nhà cung cấp cloud khi luồng local cần dự phòng. Có thể gửi ngữ cảnh ra dịch vụ ngoài và phát sinh chi phí. Lựa chọn: true = bật; false = tắt.
LOCAL_MODEL_ALLOW_CLOUD_FALLBACK=false
# @env LOCAL_MODEL_SCHEMA_SELECTOR_ENABLED: Cho AI local chọn schema. Cho phép model local tham gia chọn cấu trúc bảng liên quan. Có thể tăng số lần gọi model trước khi tạo truy vấn. Lựa chọn: true = bật; false = tắt.
LOCAL_MODEL_SCHEMA_SELECTOR_ENABLED=false

# Provider completion checks (set false to restore the legacy provider loop)
# @env AI_PROVIDER_GUARDS_ENABLED: Bảo vệ provider bên thứ ba. Bật giới hạn, kiểm tra kết quả và cơ chế sửa lỗi cho provider cloud. Lựa chọn: true = bật; false = tắt.
AI_PROVIDER_GUARDS_ENABLED=true
# @env AI_PROVIDER_MAX_REPAIRS: Số lần sửa lỗi provider. Số lần tối đa thử sửa câu trả lời hoặc tool call lỗi của provider bên thứ ba.
AI_PROVIDER_MAX_REPAIRS=2
# @env AI_PROVIDER_REQUEST_TIMEOUT_MS: Thời gian request provider. Giới hạn tổng thời gian request provider bên thứ ba, tính bằng mili giây. Đơn vị: mili giây (1000 ms = 1 giây).
AI_PROVIDER_REQUEST_TIMEOUT_MS=120000
# @env AI_PROVIDER_MAX_MODEL_CALLS: Số lần gọi provider tối đa. Ngân sách số lần gọi model bên thứ ba trong một yêu cầu.
AI_PROVIDER_MAX_MODEL_CALLS=12
# @env AI_PROVIDER_MAX_SQL_CALLS: Số lần gọi SQL của provider. Giới hạn số lần provider bên thứ ba được thực thi SQL trong một yêu cầu.
AI_PROVIDER_MAX_SQL_CALLS=3
# @env AI_PROVIDER_MAX_TOOL_CALLS: Số tool call của provider. Giới hạn tổng số công cụ provider bên thứ ba được gọi trong một yêu cầu.
AI_PROVIDER_MAX_TOOL_CALLS=20
# @env AI_PROVIDER_TOOL_RESULT_CHARS: Độ dài kết quả tool cho provider. Số ký tự tối đa của kết quả công cụ gửi lại provider bên thứ ba. Đơn vị: ký tự (hoặc ký tự/token với hệ số ước lượng).
AI_PROVIDER_TOOL_RESULT_CHARS=12000
# Conservative defaults; override contextWindow/outputReserve per provider.
# @env AI_PROVIDER_CONTEXT_WINDOW: Cửa sổ ngữ cảnh provider. Số token ngữ cảnh mặc định của provider bên thứ ba.
AI_PROVIDER_CONTEXT_WINDOW=16384
# @env AI_PROVIDER_OUTPUT_RESERVE: Token đầu ra dự phòng. Số token dành riêng cho câu trả lời của provider bên thứ ba.
AI_PROVIDER_OUTPUT_RESERVE=2048
# @env LOCAL_MODEL_SKILL_CORE_ENABLED: Bật skill nghiệp vụ local. Chọn contract nghiệp vụ theo request plan và đưa hướng dẫn tương ứng vào prompt local. Mặc định tắt cho đến khi đạt gate semantic eval. Lựa chọn: true = bật; false = tắt.
LOCAL_MODEL_SKILL_CORE_ENABLED=true
# @env LOCAL_MODEL_FEW_SHOT_ENABLED: Bật ví dụ SQL đã duyệt. Chèn tối đa các ví dụ tương thích với skill và schema đã chọn. Chỉ có tác dụng khi skill nghiệp vụ cũng được bật. Lựa chọn: true = bật; false = tắt.
LOCAL_MODEL_FEW_SHOT_ENABLED=true
# @env LOCAL_MODEL_MAX_ITERATIONS: Số vòng xử lý local tối đa. Giới hạn vòng suy luận và gọi công cụ cho một yêu cầu local. Tăng cho tác vụ phức tạp, đồng thời tăng thời gian xử lý.
LOCAL_MODEL_MAX_ITERATIONS=7
# @env LOCAL_MODEL_MAX_MODEL_CALLS: Số lần gọi model local tối đa. Ngân sách tổng số request gửi model trong một yêu cầu, bao gồm retry provider và lượt tổng hợp cuối.
LOCAL_MODEL_MAX_MODEL_CALLS=12
# @env LOCAL_MODEL_MAX_SQL_CALLS: Số lần gọi SQL tối đa. Giới hạn số lần thực thi công cụ SQL trong một yêu cầu local, giúp kiểm soát tải truy vấn.
LOCAL_MODEL_MAX_SQL_CALLS=3
# @env LOCAL_MODEL_MAX_REPAIRS: Số lần sửa lỗi tối đa. Số lần luồng local được thử sửa lỗi. Đặt 0 để không thử sửa; tăng có thể giúp phục hồi nhưng kéo dài thời gian.
LOCAL_MODEL_MAX_REPAIRS=1
# @env LOCAL_MODEL_TOOL_RESULT_CHARS: Độ dài kết quả công cụ. Ngân sách ký tự cho kết quả công cụ gửi lại model local. Giá trị thấp giảm ngữ cảnh nhưng có thể lược bớt chi tiết. Đơn vị: ký tự (hoặc ký tự/token với hệ số ước lượng).
LOCAL_MODEL_TOOL_RESULT_CHARS=6000
# @env LOCAL_MODEL_TEMPERATURE: Độ ngẫu nhiên của câu trả lời. Từ 0 đến 2. Giá trị thấp như 0.1 phù hợp tác vụ SQL cần ổn định; giá trị cao làm câu trả lời đa dạng hơn.
LOCAL_MODEL_TEMPERATURE=0.1
# @env LOCAL_MODEL_NUM_CTX: Kích thước ngữ cảnh local. Số token ngữ cảnh yêu cầu cho Ollama. Tăng để chứa nhiều thông tin hơn, đồng thời cần thêm bộ nhớ và phải được model hỗ trợ.
LOCAL_MODEL_NUM_CTX=16384
# @env LOCAL_MODEL_NUM_PREDICT: Giới hạn token đầu ra. Số token tối đa model local được sinh. Tăng cho câu trả lời dài; có thể tăng thời gian chạy.
LOCAL_MODEL_NUM_PREDICT=2048
# @env LOCAL_MODEL_KEEP_ALIVE: Thời gian giữ model trong bộ nhớ. Thời gian Ollama giữ model sau yêu cầu, ví dụ 10m = 10 phút. Giữ lâu giúp lần gọi sau nhanh hơn nhưng chiếm bộ nhớ.
LOCAL_MODEL_KEEP_ALIVE=10m

# Dynamic schema retrieval budget
# @env LOCAL_MODEL_TABLE_PREFIX: Tiền tố bảng nghiệp vụ. Tiền tố dùng để nhận diện bảng dữ liệu chính khi local model lập kế hoạch SQL.
LOCAL_MODEL_TABLE_PREFIX=T_
# @env LOCAL_MODEL_DATE_COLUMN_HINTS: Gợi ý cột ngày. Danh sách tên cột ngày ưu tiên, phân cách bằng dấu phẩy.
LOCAL_MODEL_DATE_COLUMN_HINTS=ToDate,PaymentDate,CreateDate
# @env AI_SCHEMA_MAX_TABLES: Số bảng trong ngữ cảnh. Số bảng tối đa đưa vào ngữ cảnh schema. Tăng hỗ trợ truy vấn nhiều bảng nhưng tiêu tốn thêm token.
AI_SCHEMA_MAX_TABLES=6
# @env AI_SCHEMA_MAX_COLUMNS_PER_TABLE: Số cột cho mỗi bảng. Giới hạn cột được lấy từ mỗi bảng. Bộ đọc schema dùng tối thiểu 5 cột; tăng khi cần nhiều thuộc tính.
AI_SCHEMA_MAX_COLUMNS_PER_TABLE=40
# @env AI_SCHEMA_MAX_CONTEXT_CHARS: Độ dài ngữ cảnh schema. Ngân sách ký tự mô tả cấu trúc CSDL. Bộ đọc dùng tối thiểu 2000 ký tự; tăng để giữ thêm thông tin bảng và cột. Đơn vị: ký tự (hoặc ký tự/token với hệ số ước lượng).
AI_SCHEMA_MAX_CONTEXT_CHARS=18000
# @env SQL_RELATIONSHIP_DISCOVERY_ENABLED: Khám phá quan hệ tự động. Cho phép tính năng đề xuất quan hệ giữa các bảng. Lựa chọn: true = bật; false = tắt.
SQL_RELATIONSHIP_DISCOVERY_ENABLED=false
# @env SQL_JOIN_PLANNER_ENABLED: Bật JOIN planner. Cho phép lập kế hoạch JOIN theo quan hệ đã cấu hình. Lựa chọn: true = bật; false = tắt.
SQL_JOIN_PLANNER_ENABLED=false
# @env SQL_JOIN_MAX_EDGES: Số cạnh JOIN tối đa. Giới hạn số quan hệ trên một kế hoạch JOIN; mặc định 3, tối đa 20.
SQL_JOIN_MAX_EDGES=3
# @env SQL_AUTO_ENRICH_MAX_RELATIONSHIPS: Số quan hệ làm giàu tối đa. Số quan hệ lookup tối đa tự động thêm vào kết quả; mặc định 6.
SQL_AUTO_ENRICH_MAX_RELATIONSHIPS=6
# @env MODEL_DATA_INTENT_PLANNER_ENABLED: Model lập kế hoạch ý định dữ liệu. Yêu cầu local model phân loại bảng gốc, lookup, bộ lọc quan hệ và grain trước khi chạy SQL. Lựa chọn: true = bật; false = tắt.
MODEL_DATA_INTENT_PLANNER_ENABLED=false

# Backend conversation memory
# @env MAX_CHAT_HISTORY: Lịch sử chat toàn hệ thống. Số bản ghi lịch sử chat tối đa được giữ lại.
MAX_CHAT_HISTORY=5000
# @env MEMORY_CORE_ENABLED: Bật Memory Core. Bật bộ nhớ ngữ cảnh và tham chiếu xuyên lượt chat. Lựa chọn: true = bật; false = tắt.
MEMORY_CORE_ENABLED=true
# @env MEMORY_CORE_SHADOW_MODE: Memory Core shadow mode. Chạy phân tích Memory Core nhưng không áp dụng kết quả vào câu trả lời. Lựa chọn: true = bật; false = tắt.
MEMORY_CORE_SHADOW_MODE=false
# @env MEMORY_PERSIST_PARTIAL: Lưu kết quả một phần. Cho phép ghi nhớ câu trả lời chỉ hoàn thành một phần khi đã qua đánh giá. Lựa chọn: true = bật; false = tắt.
MEMORY_PERSIST_PARTIAL=false
# @env MEMORY_TRACE_ENABLED: Ghi trace bộ nhớ. Ghi thông tin xử lý Memory Core phục vụ kiểm tra lỗi. Lựa chọn: true = bật; false = tắt.
MEMORY_TRACE_ENABLED=true
# @env MEMORY_STRICT_REFERENCE_RESOLUTION: Giải tham chiếu nghiêm ngặt. Yêu cầu tham chiếu như “người đó” hoặc “bảng trên” phải được xác định chắc chắn. Lựa chọn: true = bật; false = tắt.
MEMORY_STRICT_REFERENCE_RESOLUTION=true
# @env MEMORY_DATASET_ENTITY_LIMIT: Số thực thể dữ liệu ghi nhớ. Giới hạn số thực thể lấy từ kết quả dữ liệu để lưu làm tham chiếu.
MEMORY_DATASET_ENTITY_LIMIT=20
# @env AI_MEMORY_RECENT_MESSAGES: Số tin nhắn gần đây. Tham số dự kiến cho số tin nhắn gần nhất trong ngữ cảnh. Chưa thấy mã backend hiện tại đọc biến này; thay đổi có thể chưa có tác dụng.
AI_MEMORY_RECENT_MESSAGES=10
# @env AI_MEMORY_MAX_MESSAGES: Số tin nhắn lưu trong phiên. Giới hạn số tin nhắn giữ cho một phiên hội thoại. Tăng để giữ lịch sử dài hơn và dùng thêm dung lượng.
AI_MEMORY_MAX_MESSAGES=40
# @env AI_MEMORY_SUMMARY_CHARS: Độ dài tóm tắt hội thoại. Ngân sách ký tự dự kiến cho tóm tắt. Chưa thấy mã backend hiện tại đọc biến này; thay đổi có thể chưa có tác dụng. Đơn vị: ký tự (hoặc ký tự/token với hệ số ước lượng).
AI_MEMORY_SUMMARY_CHARS=4000
# @env AI_MEMORY_MAX_SESSIONS: Số phiên hội thoại tối đa. Giới hạn số phiên được bộ nhớ hội thoại lưu giữ. Tăng khi cần phục vụ nhiều phiên đồng thời.
AI_MEMORY_MAX_SESSIONS=500

# Qdrant Vector Database Configuration
# @env QDRANT_URL: Địa chỉ Qdrant. URL dịch vụ vector, ví dụ http://127.0.0.1:6333. Đây là nơi lưu chỉ mục để tìm schema và tài liệu liên quan.
QDRANT_URL=http://127.0.0.1:6333
# Local startup uses the knowledgehub-qdrant Docker service, not qdrant.exe.
# @env QDRANT_COLLECTION: Collection cấu trúc CSDL. Tên tập vector dành cho schema. Đổi tên sẽ trỏ sang tập dữ liệu khác; cần có chỉ mục tương ứng.
QDRANT_COLLECTION=database_schema_v2
# @env QDRANT_VECTOR_SIZE: Số chiều vector schema. Phải khớp kích thước vector của model và collection schema. Không đổi riêng giá trị này nếu chưa chuẩn bị collection phù hợp.
QDRANT_VECTOR_SIZE=1024
# @env LIBRARY_MAX_FILE_MB: Dung lượng tài liệu tối đa. Giới hạn kích thước mỗi tài liệu tải lên, tính bằng MB. Tăng cho file lớn hơn nhưng cần thêm tài nguyên xử lý.
LIBRARY_MAX_FILE_MB=20
# @env QDRANT_DOCUMENT_COLLECTION: Collection tài liệu. Tên tập vector của thư viện tri thức. Khi chuyển model embedding, nên dùng collection tương thích và lập chỉ mục lại.
QDRANT_DOCUMENT_COLLECTION=knowledge_documents_bge_m3_v1
# @env QDRANT_DOCUMENT_VECTOR_SIZE: Số chiều vector tài liệu. Phải khớp đầu ra model embedding tài liệu. Ví dụ BGE-M3 thường dùng 1024 chiều.
QDRANT_DOCUMENT_VECTOR_SIZE=1024
# @env AI_DOCUMENT_MIN_SCORE: Ngưỡng liên quan tài liệu. Ngưỡng điểm từ 0 đến 1 để chọn tài liệu. Tăng giúp lọc chặt hơn nhưng có thể bỏ sót kết quả hữu ích.
AI_DOCUMENT_MIN_SCORE=0.15

# Document embedding (BGE-M3 through Ollama or an OpenAI-compatible endpoint)
# @env EMBEDDING_PROVIDER: Dịch vụ tạo embedding. ollama: dùng Ollama nội bộ; openai: endpoint tương thích OpenAI. Dịch vụ chuyển văn bản thành vector để tìm kiếm. ollama: endpoint Ollama; openai: endpoint embedding tương thích OpenAI.
EMBEDDING_PROVIDER=ollama
# @env EMBEDDING_BASE_URL: Địa chỉ dịch vụ embedding. URL máy chủ cung cấp model embedding, ví dụ http://127.0.0.1:11434 cho Ollama.
EMBEDDING_BASE_URL=http://127.0.0.1:11434
# @env EMBEDDING_MODEL: Model embedding. Tên model chuyển văn bản thành vector, ví dụ bge-m3. Đổi model có thể yêu cầu đổi số chiều và lập chỉ mục tài liệu lại.
EMBEDDING_MODEL=bge-m3
# Set to "error" in production to prohibit pseudo-vector fallback.
# @env EMBEDDING_FALLBACK_MODE: Xử lý khi embedding lỗi. error: báo lỗi và dừng. deterministic: dùng vector dự phòng, không đảm bảo chất lượng tìm kiếm ngữ nghĩa. error: báo lỗi khi embedding thất bại; deterministic: dùng vector dự phòng, chất lượng tìm kiếm không được bảo đảm.
EMBEDDING_FALLBACK_MODE=error

# Hybrid retrieval and optional cross-encoder reranking
# @env RETRIEVAL_CANDIDATE_LIMIT: Số ứng viên tìm kiếm. Số kết quả ứng viên cho bước truy xuất. Tăng để xét nhiều đoạn hơn trước khi chọn nội dung gửi AI.
RETRIEVAL_CANDIDATE_LIMIT=30
# @env RRF_K: Hệ số gộp thứ hạng. Hệ số Reciprocal Rank Fusion khi kết hợp các nguồn tìm kiếm. Giá trị lớn giảm chênh lệch trọng số giữa các vị trí đứng đầu.
RRF_K=60
# @env RERANKER_ENABLED: Xếp hạng lại kết quả. Bật model reranker để đánh giá lại độ liên quan của kết quả. Cần dịch vụ reranker hoạt động và có thể tăng độ trễ. Lựa chọn: true = bật; false = tắt.
RERANKER_ENABLED=false
# @env RERANKER_BASE_URL: Địa chỉ reranker. URL dịch vụ xếp hạng lại kết quả, được dùng khi bật reranker.
RERANKER_BASE_URL=http://127.0.0.1:8081
# @env RERANKER_MODEL: Model reranker. Tên model đánh giá độ phù hợp giữa câu hỏi và đoạn tài liệu. Phải được dịch vụ reranker hỗ trợ.
RERANKER_MODEL=bge-reranker-v2-m3
# @env RERANKER_MAX_CANDIDATES: Số ứng viên reranker. Số đoạn tối đa gửi tới dịch vụ reranker.
RERANKER_MAX_CANDIDATES=20
# @env RERANKER_MAX_DOCUMENT_CHARS: Độ dài mỗi đoạn reranker. Số ký tự tối đa của mỗi đoạn gửi tới reranker. Đơn vị: ký tự (hoặc ký tự/token với hệ số ước lượng).
RERANKER_MAX_DOCUMENT_CHARS=1600
# @env RERANKER_MAX_TOTAL_CHARS: Tổng dữ liệu reranker. Tổng số ký tự tối đa gửi trong một lần rerank. Đơn vị: ký tự (hoặc ký tự/token với hệ số ước lượng).
RERANKER_MAX_TOTAL_CHARS=24000
# @env AI_DOCUMENT_CONTEXT_TOKENS: Token ngữ cảnh tài liệu. Ngân sách token tài liệu được đóng gói và gửi tới model.
AI_DOCUMENT_CONTEXT_TOKENS=3000
# @env GRAPHRAG_ENABLED: Tìm kiếm theo quan hệ. Bật khả năng truy xuất theo quan hệ khi câu hỏi phù hợp, bổ sung cho tìm kiếm văn bản và vector. Lựa chọn: true = bật; false = tắt.
GRAPHRAG_ENABLED=true
# Enable once after changing the embedding model/collection, then turn it off.
# @env KNOWLEDGE_REINDEX_ON_START: Lập chỉ mục lại khi khởi động. Bật để xây dựng lại chỉ mục tri thức ở lần khởi động. Có thể mất nhiều thời gian; tắt sau khi hoàn tất. Lựa chọn: true = bật; false = tắt.
KNOWLEDGE_REINDEX_ON_START=false
# Memory Core v2 feature flags and limits
# @env MEMORY_PENDING_TURN_ENABLED: Ghi nhớ lượt đang chờ. Giữ yêu cầu còn thiếu thông tin để tiếp tục ở lượt chat sau. Lựa chọn: true = bật; false = tắt.
MEMORY_PENDING_TURN_ENABLED=true
# @env MEMORY_PENDING_TURN_TTL_MINUTES: Thời hạn lượt đang chờ. Số phút giữ một yêu cầu chưa hoàn tất trong Memory Core.
MEMORY_PENDING_TURN_TTL_MINUTES=30
# @env MEMORY_CONTEXT_BUDGET_ENABLED: Giới hạn ngữ cảnh bộ nhớ. Phân bổ lịch sử hội thoại theo ngân sách token của model. Lựa chọn: true = bật; false = tắt.
MEMORY_CONTEXT_BUDGET_ENABLED=true
# @env MEMORY_SUMMARY_ENABLED: Bật tóm tắt bộ nhớ. Dùng bản tóm tắt để giữ ngữ cảnh cũ khi lịch sử dài. Lựa chọn: true = bật; false = tắt.
MEMORY_SUMMARY_ENABLED=true
# @env MEMORY_SEMANTIC_ROUTING_ENABLED: Định tuyến bộ nhớ ngữ nghĩa. Bật chọn ngữ cảnh bộ nhớ theo độ liên quan ngữ nghĩa. Lựa chọn: true = bật; false = tắt.
MEMORY_SEMANTIC_ROUTING_ENABLED=false
# @env MEMORY_TOKEN_CHARS_PER_TOKEN: Tỷ lệ ký tự trên token. Hệ số ước lượng số token từ độ dài văn bản khi phân bổ ngữ cảnh. Đơn vị: ký tự (hoặc ký tự/token với hệ số ước lượng).
MEMORY_TOKEN_CHARS_PER_TOKEN=3.2

# App storage. Import data and run data:pg:cutover before starting PostgreSQL runtime.
# Modes: postgres = PostgreSQL; json = files in KNOWLEDGEHUB_DATA_DIR.
# Restart after changing modes; data is NOT migrated or synced automatically.
# @env APP_STORAGE_BACKEND: Backend lưu trữ. Chọn PostgreSQL cho vận hành chính hoặc JSON file cho môi trường phù hợp. postgres: PostgreSQL; json: file JSON. Đổi chế độ không tự di chuyển/đồng bộ dữ liệu; cần migration trước và restart sau.
APP_STORAGE_BACKEND=postgres
# @env APP_PG_HOST: Máy chủ PostgreSQL. Hostname hoặc địa chỉ IP của PostgreSQL.
APP_PG_HOST=127.0.0.1
# @env APP_PG_PORT: Cổng PostgreSQL. Cổng kết nối PostgreSQL, mặc định 5432.
APP_PG_PORT=5432
# @env APP_PG_DATABASE: Tên database PostgreSQL. Database lưu dữ liệu ứng dụng.
APP_PG_DATABASE=knowledgehub_app
# @env APP_PG_POOL_MAX: Số kết nối PostgreSQL. Số kết nối tối đa trong connection pool.
APP_PG_POOL_MAX=5
# @env APP_PG_CONNECT_TIMEOUT_MS: Thời gian kết nối PostgreSQL. Giới hạn thời gian mở kết nối PostgreSQL, tính bằng mili giây. Đơn vị: mili giây (1000 ms = 1 giây).
APP_PG_CONNECT_TIMEOUT_MS=5000
# @env APP_PG_STATEMENT_TIMEOUT_MS: Thời gian chạy câu lệnh PostgreSQL. Giới hạn thời gian thực thi một câu lệnh storage, tính bằng mili giây. Đơn vị: mili giây (1000 ms = 1 giây).
APP_PG_STATEMENT_TIMEOUT_MS=30000
# @env APP_PG_DOCKER_CONTAINER: Tên container PostgreSQL. Tên Docker container PostgreSQL dùng bởi công cụ quản trị và sao lưu.
APP_PG_DOCKER_CONTAINER=knowledgehub-postgres
# Generated locally by npm run db:pg:init in ignored .env.postgres:
# @env APP_PG_USER: Tài khoản PostgreSQL quản trị dữ liệu. Tài khoản dùng cho công cụ khởi tạo/migration. Script db:pg:init ghi thông tin riêng vào .env.postgres.
# APP_PG_USER=knowledgehub_migrator
# @env APP_PG_PASSWORD: Mật khẩu PostgreSQL quản trị dữ liệu. Mật khẩu của APP_PG_USER; giữ riêng trong .env.postgres, không đưa vào mã nguồn.
# APP_PG_PASSWORD=
# @env APP_PG_RUNTIME_USER: Tài khoản PostgreSQL runtime. Tài khoản giới hạn quyền dùng khi backend truy cập PostgreSQL trong vận hành.
# APP_PG_RUNTIME_USER=knowledgehub_runtime
# @env APP_PG_RUNTIME_PASSWORD: Mật khẩu PostgreSQL runtime. Mật khẩu của APP_PG_RUNTIME_USER; giữ riêng trong .env.postgres.
# APP_PG_RUNTIME_PASSWORD=
# @env APP_DATA_ENCRYPTION_KEY_FILE: File khóa mã hóa dữ liệu. Đường dẫn khóa dùng mã hóa/giải mã dữ liệu nhạy cảm lưu trong PostgreSQL. Giữ nguyên khóa để đọc được dữ liệu đã mã hóa; sao lưu khóa riêng.
# APP_DATA_ENCRYPTION_KEY_FILE=C:\Users\<user>\.knowledgehub\keys\<id>.key
# For remote PostgreSQL, provide a trusted CA file (certificate checks stay enabled):
# @env APP_PG_SSL_CA_FILE: Chứng chỉ CA PostgreSQL. Đường dẫn CA tin cậy để xác thực TLS khi kết nối PostgreSQL từ xa; không tắt kiểm tra chứng chỉ.
# APP_PG_SSL_CA_FILE=

# Phase 1: default off. An admin may persistently toggle it in Workflow UI.
# @env WORKFLOW_PLUGINS_ENABLED: Bật mẫu nghiệp vụ. Cho phép nhận diện và chạy mẫu nghiệp vụ trong hội thoại và embed chat. Tắt để ngừng tạo và chạy tác vụ. Áp dụng sau khi khởi động lại máy chủ; cấu hình tạm tắt tại trang Mẫu nghiệp vụ vẫn được giữ. Lựa chọn: true = bật; false = tắt.
WORKFLOW_PLUGINS_ENABLED=false
# Optional exact origins for private-network or HTTP API sources, comma-separated.
# Example: https://api.internal.example,http://localhost:8080
# @env WORKFLOW_API_ALLOWED_ORIGINS: API nguồn nội bộ được cho phép. Danh sách origin chính xác được workflow gọi, phân cách bằng dấu phẩy, ví dụ https://api.internal.example,http://localhost:8080. Để trống nếu không cần ngoại lệ cho API HTTP/mạng riêng.
WORKFLOW_API_ALLOWED_ORIGINS=
