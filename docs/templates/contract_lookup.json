            },
            {
              "key": "StartDate",
              "tableId": "db-src-1785684548077::ipms::dbo::t_contract",
              "columnName": "StartDate",
              "relationId": null,
              "label": "Ngày bắt đầu"
            },
            {
              "key": "EndDate",
              "tableId": "db-src-1785684548077::ipms::dbo::t_contract",
              "columnName": "EndDate",
              "relationId": null,
              "label": "Ngày kết thúc"
            },
            {
              "key": "StatusID",
              "tableId": "db-src-1785684548077::ipms::dbo::t_contract",
              "columnName": "StatusID",
              "relationId": "00718638-d706-4e23-9e66-6674c762f143",
              "label": "Trạng thái"
            },
            {
              "key": "IsVAT",
              "tableId": "db-src-1785684548077::ipms::dbo::t_contract",
              "columnName": "IsVAT",
              "relationId": null,
              "label": "IsVAT"
            },
            {
              "key": "Note",
              "tableId": "db-src-1785684548077::ipms::dbo::t_contract",
              "columnName": "Note",
              "relationId": null,
              "label": "Note"
            },
            {
              "key": "CompanyID",
              "tableId": "db-src-1785684548077::ipms::dbo::t_contract",
              "columnName": "CompanyID",
              "relationId": null,
              "label": "CompanyID"
            }
          ],
          "sql": "SELECT TOP 50 e.[ContractID] AS [ContractID], e.[TypeID] AS [TypeID], e.[ContractNo] AS [ContractNo], e.[ContractDate] AS [ContractDate], e.[ContractTypeID] AS [ContractTypeID], r5.[EmployeeName] AS [EmployeeID], r6.[CustomerName] AS [CustomerID], e.[TotalArea] AS [TotalArea], e.[Qty] AS [Qty], e.[StartDate] AS [StartDate], e.[EndDate] AS [EndDate], r11.[ConstantName] AS [StatusID], e.[IsVAT] AS [IsVAT], e.[Note] AS [Note], e.[CompanyID] AS [CompanyID] FROM [dbo].[T_Contract] e LEFT JOIN [dbo].[M_Employee] r5 ON e.[EmployeeID] = r5.[EmployeeID] LEFT JOIN [dbo].[M_Customer] r6 ON e.[CustomerID] = r6.[CustomerID] LEFT JOIN [dbo].[M_Constant] r11 ON e.[StatusID] = r11.[ConstantID] WHERE e.[ContractNo] LIKE CONCAT('%', REPLACE(REPLACE(REPLACE(@query, '[', '[[]'), '%', '[%]'), '_', '[_]'), '%') OR r6.[CustomerName] LIKE CONCAT('%', REPLACE(REPLACE(REPLACE(@query, '[', '[[]'), '%', '[%]'), '_', '[_]'), '%') ORDER BY e.[ContractNo], e.[ContractID]",
          "parameters": {
            "query": {
              "slot": "query",
              "type": "string"
            }
          }
        }
      },
      "workflow": {
        "steps": [
          {
            "id": "lookup",
            "name": "Tìm hợp đồng theo điều kiện tra cứu",
            "type": "sql",
            "config": {
              "bindingRef": "contract"
            }
          }
        ]
      },
