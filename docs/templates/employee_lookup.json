      "enabled": true,
      "bindings": {
        "employee": {
          "sql": "SELECT TOP 50 e.[EmployeeID] AS [EmployeeID], e.[EmployeeCode] AS [EmployeeCode], e.[EmployeeName] AS [EmployeeName], r3.[Name] AS [DepartmentID], r4.[ConstantName] AS [GenderID], e.[DOB] AS [DOB], e.[CompanyID] AS [CompanyID], e.[EmployeeTypeID] AS [EmployeeTypeID], e.[Mobile] AS [Mobile], e.[Email] AS [Email], e.[TaxCode] AS [TaxCode], e.[Note] AS [Note], e.[IsActive] AS [IsActive] FROM [dbo].[M_Employee] e LEFT JOIN [dbo].[M_Master] r3 ON e.[DepartmentID] = r3.[MasterID] LEFT JOIN [dbo].[M_Constant] r4 ON e.[GenderID] = r4.[ConstantID] WHERE e.[EmployeeCode] = @query OR e.[EmployeeName] LIKE CONCAT('%', REPLACE(REPLACE(REPLACE(@query, '[', '[[]'), '%', '[%]'), '_', '[_]'), '%') ORDER BY e.[EmployeeCode], e.[EmployeeID]",
          "tables": [
            "dbo.M_Employee",
            "dbo.M_Master",
            "dbo.M_Constant"
          ],
          "dbSourceId": "db-src-1785684548077",
